# --- deployment -------------------------------------------------------------
# Deployer key. Never commit a funded key.
PRIVATE_KEY=0x

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=

# --- game parameters --------------------------------------------------------
# Deposits on the cavern wall. Each Dig resolves in O(1) Inco ops regardless of
# grid size, so 36 (a 6x6 wall, zinc-style) is the reference default.
GRID_SIZE=36
# Minimum Dig amount (per tile for `All`), excluding the Inco fee budget.
MIN_STAKE_WEI=1000000000000000
# Starting bankroll that pays winning Digs. maxStake = bankroll * 100 / 3492;
# it must cover one minimum-stake Pick payout (0.001 * 34.92 ≈ 0.035 ETH).
BANKROLL_SEED_WEI=50000000000000000
# ETH seeded into GemHaven at deploy to prefund Inco compute fees.
INCO_FEE_RESERVE_WEI=1000000000000000
