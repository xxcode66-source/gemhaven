{
  "name": "gemhaven-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "GemHaven — confidential dig-to-earn contracts for Base (Inco Lightning + Megapot)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/compile.mjs",
    "build:forge": "forge build",
    "abi": "node scripts/compile.mjs && node scripts/sync-abi.mjs",
    "deploy:base-sepolia": "forge script script/Deploy.s.sol:Deploy --rpc-url base_sepolia --broadcast",
    "deploy:base": "forge script script/Deploy.s.sol:Deploy --rpc-url base --broadcast"
  },
  "dependencies": {
    "@inco/lightning": "1.0.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  },
  "devDependencies": {
    "solc": "0.8.29"
  }
}
