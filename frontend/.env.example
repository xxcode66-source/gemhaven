# Copy to .env.local. Every value here is public — it ships in the browser bundle.

# Printed by `forge script script/Deploy.s.sol:Deploy` in contracts/.
NEXT_PUBLIC_GEMHAVEN_ADDRESS=
NEXT_PUBLIC_SHARD_ADDRESS=

# Chain the addresses above were deployed to. 84532 = Base Sepolia (default),
# 8453 = Base mainnet.
NEXT_PUBLIC_CHAIN_ID=84532

# Optional RPC overrides. Comma-separate to use several with failover.
# Leave blank to use the chain's default public endpoint.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
